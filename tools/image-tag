#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# A source archive or a shallow checkout may not contain Git metadata. Keep
# builds from those sources usable and let callers override the fallback.
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1
then
      printf '%s\n' "${VERSION:-dev}"
      exit 0
fi

WIP=""
if [ -n "$(git status --porcelain --untracked-files=normal)" ]
then
      WIP='-WIP'
fi
BRANCH=$(git symbolic-ref --short -q HEAD 2>/dev/null || echo detached)
BRANCH=$(printf '%s' "$BRANCH" | sed 's#/#-#g')
# When 7 chars are not enough to be unique, git automatically uses more.
# We are forcing to 7 here, as we are doing for grafana/grafana as well.
SHA=$(git rev-parse --short=7 HEAD 2>/dev/null | head -c7 || echo unknown)

# If not a tag, use branch-hash else use tag.
TAG=$(git describe --exact-match 2>/dev/null || true)
TAG=$(printf '%s' "$TAG" | sed 's/^v//g')
if [ -z "$TAG" ]
then
      printf '%s\n' "${BRANCH}-${SHA}${WIP}"
else
      printf '%s%s\n' "$TAG" "$WIP"
fi
